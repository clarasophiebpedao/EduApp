<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EduApp.Views.CorrigirAtividadesPage"
             Title="Painel de Correção">

    <Grid Padding="15">

        <CollectionView ItemsSource="{Binding AtividadesPendentes}">

            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame BorderColor="LightGray" CornerRadius="10" Padding="15" HasShadow="True">
                        <Grid RowDefinitions="Auto, Auto, Auto" ColumnDefinitions="*, Auto">

                            <Label Text="{Binding AlunoNome}" 
                               FontSize="18" FontAttributes="Bold" 
                               Grid.Row="0" Grid.Column="0"/>

                            <Label Text="{Binding Pontos, StringFormat='{0} pts'}" 
                               TextColor="Blue" FontAttributes="Bold" 
                               Grid.Row="0" Grid.Column="1"/>

                            <Label Text="{Binding AtividadeTitulo}" 
                               TextColor="Gray" Margin="0,4,0,0"
                               Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"/>

                            <Button Text="Aprovar e Atribuir Pontos" 
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.AprovarCommand}"
                                CommandParameter="{Binding .}"
                                BackgroundColor="Green" TextColor="White"
                                Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" 
                                Margin="0,12,0,0"/>

                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        </Grid>
</ContentPage>