<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EduApp.Views.CriarAtividadePage"
             Title="Nova Atividade">

    <VerticalStackLayout Padding="20" Spacing="15">

        <Label Text="Título da Atividade:" />
        <Entry Text="{Binding TituloDigitado}" Placeholder="Ex: Equação de 2º Grau" />

        <Label Text="Descrição:" />
        <Editor Text="{Binding DescricaoDigitada}" HeightRequest="100" />

        <Label Text="Pontos:" />
        <Entry Text="{Binding PontosDigitados}" Keyboard="Numeric" />

        <Button Text="Salvar Atividade" 
                Command="{Binding SalvarAtividadeCommand}" 
                BackgroundColor="Blue" TextColor="White" />

    </VerticalStackLayout>
</ContentPage>