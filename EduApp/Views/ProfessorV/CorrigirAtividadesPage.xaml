<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EduApp.Views.CorrigirAtividadesPage"
             BackgroundColor="#F4FAFF"
             Title="Validar Conquistas">

    <Grid Padding="15" RowDefinitions="Auto, *">

        <VerticalStackLayout Grid.Row="0" Margin="0,0,0,15" HorizontalOptions="Center">
            <Label Text="Avaliação de Heróis 🏅"
                   FontSize="26"
                   FontAttributes="Bold"
                   TextColor="#4A4A4A"
                   HorizontalOptions="Center"/>
            <Label Text="Confira as missões entregues pelos alunos"
                   FontSize="14"
                   TextColor="#57636C"
                   HorizontalOptions="Center"/>
        </VerticalStackLayout>

        <CollectionView ItemsSource="{Binding AtividadesPendentes}" Grid.Row="1">

            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="15" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border StrokeShape="RoundRectangle 20" 
                            StrokeThickness="0" 
                            BackgroundColor="White" 
                            Padding="20"
                            MinimumHeightRequest="200">
                        <Border.Shadow>
                            <Shadow Brush="Gray" Offset="0,5" Radius="8" Opacity="0.15"/>
                        </Border.Shadow>

                        <Grid RowDefinitions="Auto, Auto, Auto" ColumnDefinitions="*, Auto">

                            <Label Text="{Binding AlunoNome}" 
                                   FontSize="20" 
                                   FontAttributes="Bold" 
                                   TextColor="#1E90FF" 
                                   Grid.Row="0" Grid.Column="0"
                                   VerticalOptions="Center"/>

                            <Border StrokeShape="RoundRectangle 15" 
                                    StrokeThickness="0" 
                                    BackgroundColor="#FFFACD" 
                                    Padding="10,5" 
                                    Grid.Row="0" Grid.Column="1" 
                                    VerticalOptions="Center">
                                <Label Text="{Binding Pontos, StringFormat='⭐ {0} XP'}" 
                                       TextColor="#FF8C00" 
                                       FontAttributes="Bold" 
                                       FontSize="14"/>
                            </Border>

                            <Label Text="{Binding AtividadeTitulo, StringFormat='📜 Missão: {0}'}" 
                                   TextColor="#57636C" 
                                   FontSize="15" 
                                   Margin="0,10,0,15"
                                   Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"/>

                            <Button Text="CONFIRMAR CONQUISTA! ⭐"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.AprovarCommand}"
                                    CommandParameter="{Binding .}"
                                    BackgroundColor="#32CD32" 
                                    TextColor="White"
                                    FontAttributes="Bold"
                                    FontSize="16"
                                    HeightRequest="60"
                                    CornerRadius="30"
                                    Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
                                <Button.Shadow>
                                    <Shadow Brush="#228B22" Offset="0,5" Radius="0" Opacity="1"/>
                                </Button.Shadow>
                            </Button>

                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Padding="50" Spacing="15">
                    <Image Source="mascote_relaxado.png" HeightRequest="150" HorizontalOptions="Center" />
                    <Label Text="Uau, Mestre! 🤩" 
                           FontSize="24" 
                           FontAttributes="Bold" 
                           TextColor="#4A4A4A" 
                           HorizontalOptions="Center"/>
                    <Label Text="Todos os heróis já foram avaliados. Hora de descansar!" 
                           FontSize="16" 
                           TextColor="#57636C" 
                           HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>

        </CollectionView>
    </Grid>
</ContentPage>