<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EduApp.Views.AlunoV.ResponderMissaoPage"
             BackgroundColor="#F4FAFF"
             Title="Sala de Missão">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20">

            <Label Text="Missão em Andamento! 🎯" 
                   FontSize="28" 
                   FontAttributes="Bold" 
                   TextColor="#FF8C00" 
                   HorizontalOptions="Center" />

            <Border StrokeShape="RoundRectangle 20" StrokeThickness="0" BackgroundColor="White" Padding="20">
                <Border.Shadow>
                    <Shadow Brush="Gray" Offset="0,4" Radius="5" Opacity="0.15"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="10">
                    <Label Text="{Binding MissaoAtual.Titulo}" FontSize="22" FontAttributes="Bold" TextColor="#1E90FF" HorizontalOptions="Center"/>

                    <Border StrokeShape="RoundRectangle 15" StrokeThickness="0" BackgroundColor="#FFFACD" Padding="10,5" HorizontalOptions="Center">
                        <Label Text="{Binding MissaoAtual.Pontos, StringFormat='Recompensa: ⭐ {0} XP'}" TextColor="#B8860B" FontAttributes="Bold" FontSize="16"/>
                    </Border>

                    <Label Text="{Binding MissaoAtual.Descricao}" FontSize="16" TextColor="#57636C" Margin="0,10,0,0"/>
                </VerticalStackLayout>
            </Border>

            <Label Text="Sua Resposta de Herói:" FontSize="18" FontAttributes="Bold" TextColor="#9370DB" Margin="0,10,0,0"/>

            <Border StrokeShape="RoundRectangle 20" StrokeThickness="2" Stroke="#E0E0E0" BackgroundColor="White" HeightRequest="150">
                <Editor Placeholder="Escreva aqui como você resolveu essa missão..." 
                        Text="{Binding TextoResposta}"
                        FontSize="16"
                        Margin="10"
                        TextColor="#333333"/>
            </Border>

            <Button Text="ENVIAR PARA O PROFESSOR! 🚀" 
                    Command="{Binding EnviarRespostaCommand}"
                    FontSize="18" 
                    FontAttributes="Bold" 
                    HeightRequest="60" 
                    CornerRadius="30"
                    BackgroundColor="#32CD32" 
                    TextColor="White" 
                    Margin="0,20,0,0">
                <Button.Shadow>
                    <Shadow Brush="#228B22" Offset="0,5" Radius="0" Opacity="1"/>
                </Button.Shadow>
            </Button>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>