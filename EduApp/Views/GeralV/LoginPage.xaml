<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EduApp.Views.LoginPage"
             BackgroundColor="#F4FAFF">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10" VerticalOptions="Center">

            <Image Source="mascote_feliz.png" 
                   HeightRequest="150" 
                   HorizontalOptions="Center" 
                   Margin="0,0,0,0" />

            <Label Text="Olá, Aventureiro! 🚀" 
                   FontSize="32" 
                   FontAttributes="Bold" 
                   TextColor="#FF8C00" 
                   HorizontalOptions="Center" />

            <Label Text="Preparado para jogar e aprender?" 
                   FontSize="18" 
                   TextColor="#4A4A4A" 
                   HorizontalOptions="Center" 
                   Margin="0,0,0,10" />

            <Border StrokeShape="RoundRectangle 25" StrokeThickness="0" BackgroundColor="White" Padding="20,5" HeightRequest="65">
                <Border.Shadow>
                    <Shadow Brush="Gray" Offset="0,4" Radius="5" Opacity="0.15"/>
                </Border.Shadow>
                <Entry Placeholder="Seu e-mail mágico" 
                       Keyboard="Email" 
                       Text="{Binding Email}" 
                       FontSize="18" 
                       TextColor="#333333" 
                       VerticalOptions="Center"/>
            </Border>

            <Border StrokeShape="RoundRectangle 25" StrokeThickness="0" BackgroundColor="White" Padding="20,5" HeightRequest="65">
                <Border.Shadow>
                    <Shadow Brush="Gray" Offset="0,4" Radius="5" Opacity="0.15"/>
                </Border.Shadow>
                <Entry Placeholder="Sua senha secreta" 
                       IsPassword="True" 
                       Text="{Binding Senha}" 
                       FontSize="18" 
                       TextColor="#333333" 
                       VerticalOptions="Center"/>
            </Border>

            <Button Text="COMEÇAR!" 
                    FontSize="24" 
                    FontAttributes="Bold" 
                    HeightRequest="70" 
                    CornerRadius="35"
                    BackgroundColor="#32CD32" 
                    TextColor="White" 
                    Margin="0,15,0,0" 
                    Command="{Binding LoginCommand}">
                <Button.Shadow>
                    <Shadow Brush="#228B22" Offset="0,6" Radius="0" Opacity="1"/>
                </Button.Shadow>
            </Button>

            <Button Text="Novo por aqui? Criar personagem" 
                    FontSize="16" 
                    FontAttributes="Bold"
                    BackgroundColor="Transparent" 
                    TextColor="#FF3B30" 
                    Clicked="OnIrParaCadastro" 
                    Margin="0,10,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>